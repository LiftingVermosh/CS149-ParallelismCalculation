__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
env/
*.egg

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Rust / Cargo ----
target/

